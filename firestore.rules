rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Destinations collection: Publicly readable; writable for package updates
    match /destinations/{destinationId} {
      allow read: if true;
      allow write: if true;
    }

    // Bookings collection: Customer reservations and admin booking manager
    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if true;
    }

    // Payments collection: Financial transactions and revenue ledger
    match /payments/{paymentId} {
      allow read: if true;
      allow write: if true;
    }

    // Users collection: Traveler profile directory
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Admin Users collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    // Emergency Requests collection: 24/7 SOS traveler assistance inquiries
    match /emergency_requests/{requestId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
